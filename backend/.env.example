# NagarNexus Backend Environment Configuration
# Copy this file to .env and customize for your environment.

APP_NAME="NagarNexus – AI-Powered Hyperlocal Urban Intelligence Platform"
APP_ENV=development
DEBUG=true

# Database Configuration
# Primary Production Database (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://nagarnexus:nagarnexus_secure_pwd@localhost:5432/nagarnexus_db
# Local Development Alternative (SQLite):
DATABASE_URL=sqlite:///./nagarnexus.db

# Security & Authentication
JWT_SECRET_KEY=replace-with-a-strong-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Paths (relative to project root or absolute paths)
UPLOAD_DIR=uploads
PROCESSED_DIR=../datasets/processed
SAMPLE_DIR=../datasets/sample
REPORTS_DIR=generated_reports
MODELS_DIR=../ml_models/trained
EVALUATION_DIR=../ml_models/evaluation
MAX_UPLOAD_SIZE_MB=50

# External API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
OPENAQ_BASE_URL=https://api.openaq.org/v2
OPENAQ_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=NagarNexus-UrbanIntelligence/1.0
DATA_GOV_IN_API_KEY=

# Optional LLM Explanation Service (Never commit actual API keys)
LLM_PROVIDER=none
LLM_API_KEY=

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

